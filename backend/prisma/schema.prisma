// Grimorium — modelo de dados
// Separação fundamental: Activity (demanda cadastrada) x ActivityLog (trabalho efetivamente executado em uma data).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Importance {
  HIGH
  MEDIUM
  LOW
}

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

// TASK: demanda com ciclo de vida (prazo, andamento, conclusão).
// CONTACT: interação rápida (chat, WhatsApp, ligação...) registrada no momento em que ocorre.
enum ActivityType {
  TASK
  CONTACT
}

enum ContactChannel {
  CHAT
  WHATSAPP
  CALL
  EMAIL
  MEETING
  OTHER
}

model Activity {
  id          Int           @id @default(autoincrement())
  // Identificador universal: viaja na exportação JSON e evita duplicar ao importar.
  uid         String        @unique @default(uuid())
  type        ActivityType  @default(TASK)
  title       String
  description String?
  category    String?
  importance  Importance    @default(MEDIUM)
  status      Status        @default(PENDING)
  createdAt   DateTime      @default(now())
  startedAt   DateTime?
  dueDate     String? // "YYYY-MM-DD" — prazo é uma data, sem horário

  completedAt DateTime?
  updatedAt   DateTime      @updatedAt

  // Somente para CONTACT
  channel     ContactChannel?
  contactName String?

  // Origem do registro: "manual" ou, futuramente, integrações ("google-chat", "whatsapp"...).
  // externalId permite importar via API sem duplicar.
  source      String        @default("manual")
  externalId  String?

  logs        ActivityLog[]

  @@unique([source, externalId])
  @@index([status])
  @@index([dueDate])
  @@index([type])
}

model ActivityLog {
  id            Int      @id @default(autoincrement())
  activityId    Int
  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  // Data de referência da execução (dia de trabalho), normalizada para "YYYY-MM-DD"
  // para facilitar contagem de atividades distintas por dia sem problemas de fuso.
  executionDate String
  description   String?
  timeSpent     Int?     // minutos
  createdAt     DateTime @default(now())

  @@index([executionDate])
  @@index([activityId, executionDate])
}

// ---------- Biblioteca: repositório pessoal de passo a passo, testes, snippets e anotações ----------

enum EntryKind {
  HOWTO
  TEST
  SNIPPET
  NOTE
}

model LibraryEntry {
  id          Int          @id @default(autoincrement())
  uid         String       @unique @default(uuid())
  title       String
  kind        EntryKind    @default(HOWTO)
  summary     String?
  content     String       @default("") // Markdown
  // Tags normalizadas (minúsculas) no formato ",tag1,tag2," para filtrar com contains(",tag,").
  tags        String       @default("")
  pinned      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]

  // Código importado do GitHub (separado das anotações em `content`, que nunca são sobrescritas).
  sourceUrl      String?   @unique
  sourceLabel    String? // ex.: "empresa/projeto · tests/login.cy.js @ main"
  sourceLanguage String?
  sourceCode     String?
  sourceSyncedAt DateTime?

  @@index([kind])
  @@index([updatedAt])
}

model Attachment {
  id           Int          @id @default(autoincrement())
  entryId      Int
  entry        LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  originalName String
  storedName   String       @unique // nome do arquivo em disco (uuid + extensão)
  mimeType     String
  size         Int
  createdAt    DateTime     @default(now())

  @@index([entryId])
}

model Report {
  id            Int      @id @default(autoincrement())
  referenceDate String   // "YYYY-MM-DD"
  content       String
  pdfPath       String?
  createdAt     DateTime @default(now())

  @@index([referenceDate])
}
